#!/usr/bin/env bash
# agentbox-enter <project> <claude|codex|agy|dev> [command...]   (default command: bash)
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"
p=${1:?usage: agentbox-enter <project> <container> [cmd...]}; c=${2:?container name}; shift 2
# Fail closed: enter only a pod that exists and carries the current layout label.
podman pod exists "ab-$p" || ab_die "pod ab-$p does not exist: start it with 'agentbox $p up'"
ab_layout_ok "ab-$p" || ab_old_layout "ab-$p"
(($#)) || set -- bash
tty=(-i); [[ -t 0 && -t 1 ]] && tty=(-it)
exec podman exec "${tty[@]}" -w /work \
  -e TERM="${TERM:-xterm-256color}" -e COLORTERM="${COLORTERM:-}" \
  "ab-$p-$c" "$@"
